<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>se.skltp.tak</groupId>
    <artifactId>tak-spring-boot-parent</artifactId>
    <version>4.4.0</version>
    <relativePath>../tak-spring-boot-parent/pom.xml</relativePath>
  </parent>

  <artifactId>tak-monitor</artifactId>
  <name>tak-monitor</name>
  <description>TAK publish monitor application</description>

  <properties>
    <kubernetes-client-java-version>25.0.0-legacy</kubernetes-client-java-version>
    <okhttp-version>5.3.2</okhttp-version> <!-- This must match whatever is referenced and used inside the io.kubernetes:client-java package above -->
  </properties>

  <dependencies>
    <dependency>
      <groupId>se.skltp.tak</groupId>
      <artifactId>tak-core</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>io.kubernetes</groupId>
      <artifactId>client-java</artifactId>
      <version>${kubernetes-client-java-version}</version>
      <exclusions>
        <exclusion>
          <groupId>com.google.protobuf</groupId>
          <artifactId>protobuf-java</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.httpcomponents</groupId>
          <artifactId>httpclient</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver</artifactId>
      <version>${okhttp-version}</version>  <!-- This must match whatever is referenced and used inside the io.kubernetes:client-java package above -->
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
