<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
			 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
			 version="3.0">

	<persistence-unit name="manager1" transaction-type="RESOURCE_LOCAL">
		<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
		<class>se.skltp.tak.core.entity.PubVersion</class>
		<class>se.skltp.tak.core.entity.RivTaProfil</class>  
		<class>se.skltp.tak.core.entity.AnropsAdress</class>  
		<class>se.skltp.tak.core.entity.Filter</class>  
		<class>se.skltp.tak.core.entity.Filtercategorization</class>  
		<class>se.skltp.tak.core.entity.LogiskAdress</class>  
		<class>se.skltp.tak.core.entity.Anropsbehorighet</class>  
		<class>se.skltp.tak.core.entity.Tjanstekomponent</class>  
		<class>se.skltp.tak.core.entity.Tjanstekontrakt</class>  
		<class>se.skltp.tak.core.entity.Vagval</class>  
		<properties>
			<property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>

			<property name="hibernate.hbm2ddl.auto" value="update"/>
			<property name="hibernate.show_sql" value="true"/>
		</properties>
	</persistence-unit>
</persistence>
