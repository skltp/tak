<?xml version="1.0" encoding="UTF-8"?>


<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
    xmlns="urn:skl:tp:vagvalsinfo:v2"
    targetNamespace="urn:skl:tp:vagvalsinfo:v2"
    elementFormDefault="qualified" 
    attributeFormDefault="unqualified">

	<xs:import schemaLocation="../../core_components/vagvalsinfo-coretypes-1.0.xsd" namespace="urn:skl:tp:core:v1"/>
	
	<xs:element name="tjanstekomponentInfo" type="tjanstekomponentInfoType"/>

	<xs:complexType name="tjanstekomponentInfoType">
		<xs:sequence>
            <xs:element name="hsaId" type="xs:string"/>
            <xs:element name="beskrivning" type="xs:string"/>
            <xs:element name="anropsAdressInfo" type="anropsAdressInfoType" minOccurs="0" maxOccurs="unbounded" nillable="true"/>
            <xs:element name="anropsbehorighetInfo" type="anropsbehorighetInfoForTjanstekomponentType" minOccurs="0" maxOccurs="unbounded" nillable="true"/>

			<xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="anropsAdressInfoType">
		<xs:sequence>
            <xs:element name="adress" type="xs:string"/>
            <xs:element name="rivtaProfilNamn" type="xs:string"/>
            <xs:element name="vagvalsInfo" type="vagvalsInfoType" minOccurs="0" maxOccurs="unbounded" nillable="true"/>

			<xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="vagvalsInfoType">
		<xs:sequence>
            <xs:element name="fromTidpunkt" type="xs:dateTime"/>
            <xs:element name="tomTidpunkt" type="xs:dateTime"/>
            <xs:element name="tjanstekontraktNamnrymd" type="xs:string"/>
            <xs:element name="logiskAdressHsaId" type="xs:string"/>
            <xs:element name="logiskAdressBeskrivning" type="xs:string"/>

			<xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<!-- The type is named "anropsbehorighetInfoForTjanstekomponentType", rather than the more natural
		"anropsbehorighetInfoType" since the latter name is already taken in file vagvalsinfo-anropsbehorighetsinfo-2.0.xsd,
		and already in use by VP -->
	<xs:complexType name="anropsbehorighetInfoForTjanstekomponentType">
		<xs:sequence>
            <xs:element name="fromTidpunkt" type="xs:dateTime"/>
            <xs:element name="tomTidpunkt" type="xs:dateTime"/>
            <xs:element name="integrationsavtal" type="xs:string"/>
            <xs:element name="tjanstekontraktNamnrymd" type="xs:string"/>
            <xs:element name="logiskAdressHsaId" type="xs:string"/>
            <xs:element name="logiskAdressBeskrivning" type="xs:string"/>

			<xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

</xs:schema>
